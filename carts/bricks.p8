pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- bricks demo cart
-- by Chris January
state=0

cartdata("bricks")
hiscore=dget(0)

bspr={
  {1,6,9},
  {3,10},
  {2,7,8},
  {4,5,11},
  {1,6,9}
}

bricksh=16
bricksv=5
brickw=8
brickh=5
brickstop=20
batw=32
bath=3
batsp=3
ballr=2
ballsp=3
ballmaxsp=5

function next_life()
  batx=64-batw/2
  baty=110
  ballx=64
  bally=baty-ballr
  balldx=0
  balldy=0
end

function next_level()
  srand(level)

  batc=flr(rnd(5))
  ballc=(batc+flr(rnd(4)))%5
  if ballc==batc then
    ballc=(ballc+1)%5
  end
  
  nbrickc=flr(rnd(2))+3
  brickc={}
  for i=1,nbrickc do
    c=flr(rnd(13))+1
    while count(bspr[batc+1], c)>0 or count(bspr[ballc+1], c)>0 or count(brickc, c)>0 do
      c+=1
    end
    add(brickc, c)
  end
  
  bricks={}
  pat=flr(rnd(3))
  for v=0,bricksv-1 do
    r={}
    for h=0,bricksh-1 do
      if pat==0 then
        c=brickc[(v%#brickc)+1]
      elseif pat==1 then
        c=brickc[(h%#brickc)+1]
      else
        c=brickc[(h+v)%#brickc+1]
      end
      add(r, c)
    end
    add(bricks, r)
  end

  next_life()
end

function new_game()
  score=0
  level=1
  lives=3
  beathi=false
  dead=false

  next_level()
end

function _init()
  new_game()
end

function _draw()
  cls(0)

  for v=1,bricksv do
    y=(v-1)*brickh+brickstop
    for h=1,bricksh do
      x=(h-1)*brickw
      if bricks[v][h] > 0 then
        spr(bricks[v][h], x, y)
      elseif bricks[v][h] < 0 then
        spr(23-bricks[v][h], x, y)
      end
    end
  end
  
  spr(32+batc*3,batx,baty)
  for x=batx+8,batx+batw-16,8 do
    spr(33+batc*3,x,baty)
  end
  spr(34+batc*3,batx+batw-8,baty)
  
  spr(16+ballc,ballx-4,bally-4)

  for i=1,lives do
    spr(16+ballc,44+i*8,-1)
  end

  if state==0 then
    print("press 🅾️ to start", 32, 50, 7)
  end

  if score>0 then
    s=tostr(score).."00"
  else
    s="0"
  end
  print(s, 0, 0, 7)
  local col
  if beathi then
    col=10
  else
    col=7
  end
  if hiscore>0 then
    s=tostr(hiscore).."00"
  else
    s="0"
  end
  print(s, 128-#s*4, 0, col)
end

function collide(x, y, w, h)
  if ballx + ballr > x and ballx - ballr < x + w and bally + ballr > y and bally - ballr < y + h then
    if bally < y then
      bally  = (y-ballr)*2 - bally
      balldy = -balldy
    elseif bally > y + h then
      bally  = (y+h+ballr)*2 - bally
      balldy = -balldy
    elseif ballx < x then
      ballx  = (x-ballr)*2 - ballx
      balldx = -balldx
    else
      ballx  = (x+w+ballr)*2 - ballx
      balldx = -balldx
    end
    assert(not (ballx + ballr > x and ballx - ballr < x + w and bally + ballr > y and bally - ballr < y + h))
    return true
  else
    return false
  end  
end

function _update()
  if state==0 then
    if btnp(🅾️) then
      new_game()
      state=1
    end
  elseif state==1 then
    obatx=batx

    batdx = 0
    if btn(⬅️) and batx>0 then
      batdx = -batsp
    end
    if btn(➡️) and batx<128-batw then
      batdx = batsp
    end
    batx += batdx

    if balldx==0 and balldy==0 then
      if btn(🅾️) then
        balldx=rnd(ballsp*2)-ballsp
        balldy=-sqrt(ballsp*ballsp-balldx*balldx)
      else
        ballx = batx+batw/2
      end
    end

    sp = sqrt(balldx*balldx+balldy*balldy)
    for i=0,sp-1 do
      ballx += balldx / sp
      bally += balldy / sp

      if collide(batx, baty, batw, bath) then
        sfx(0)
        if batdx != 0 and sp < ballmaxsp then
          balldx += 0.002 * batdx
        elseif sp > ballsp then
          balldx = 0.9 * balldx
        end
      end

      any_bricks=false
      for v=1,bricksv do
        bricky=(v-1)*brickh+brickstop
        for h=1,bricksh do
          brickx=(h-1)*brickw
          if bricks[v][h] > 0 then
            any_bricks=true
            if collide(brickx, bricky, brickw, brickh) then
              sfx(3)
              bricks[v][h] = -1
              score += level
              if score>hiscore then
                hiscore=score
                if not beathi then
                  sfx(1)
                  beathi=true
                end
              end
            end
          elseif bricks[v][h] < 0 then
            if bricks[v][h] == -5 then
              bricks[v][h] = 0
            else
              bricks[v][h] -= 1
            end
          end
        end
      end

      collide(-128, 0, 128, 128)
      collide(0, -128, 128, 128)
      collide(128, 0, 128, 128)
      if collide(0, 128, 128, 128) then
        sfx(2)
        lives=lives-1
        if lives==0 then
          ballx=-128
          bally=-128
          state=0
          if beathi then
            dset(0, score)
          end
        else
          next_life()
        end
      end

      if not any_bricks then
        level=level+1
        sfx(4)
        next_level()
      end
    end
  end
end

