ABS_VERILATED_DIR := $(shell pwd)/$(VERILATED_DIR)

$(VERILATED_DIR)/.touch: $(NEXTP8_CORE)/nextp8.srcs/sources_1/p8audio.sv $(NEXTP8_CORE)/nextp8.srcs/sources_1/p8sfx_core_mux.sv $(NEXTP8_CORE)/nextp8.srcs/sources_1/fp_ops.sv | $(VERILATED_DIR)
	$(VERILATOR) --compiler gcc --prefix Vp8audio --Mdir $(ABS_VERILATED_DIR) --make gmake \
		--top p8audio --cc -y $(NEXTP8_CORE)/nextp8.srcs/sources_1 \
		$(VERILATOR_FLAGS) \
		$(NEXTP8_CORE)/nextp8.srcs/sources_1/p8audio.sv \
		$(NEXTP8_CORE)/nextp8.srcs/sources_1/fp_ops.sv
	$(MAKE) -C $(ABS_VERILATED_DIR) -f Vp8audio.mk
	touch $(VERILATED_DIR)/.touch

$(BUILD_DIR)/p8_audio_verilated.o: src/p8_audio_verilated.cpp $(VERILATED_DIR)/.touch
	$(CXX) $(CXXFLAGS) -I$(VERILATED_DIR) -I$(VERILATOR_ROOT)/include -c $< -o $@ -Wno-error

$(VERILATED_DIR):
	mkdir -p $(VERILATED_DIR)

# Clean rule for verilated files
clean::
	rm -rf $(VERILATED_DIR)