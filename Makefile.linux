# USE_NEXTP8_AUDIO flag - set to 1 if nextp8-core exists
ifneq ($(wildcard nextp8-core),)
  DEFAULT_USE_NEXTP8_AUDIO := 1
else ifneq ($(wildcard ../nextp8-core),)
  DEFAULT_USE_NEXTP8_AUDIO := 1
else
  DEFAULT_USE_NEXTP8_AUDIO := 0
endif
USE_NEXTP8_AUDIO ?= $(DEFAULT_USE_NEXTP8_AUDIO)

# SDL2: use system-installed SDL2 dev package via pkg-config.
SDL_CFLAGS := $(shell pkg-config --cflags sdl2 2>/dev/null)
SDL_LIBS   := $(shell pkg-config --libs   sdl2 2>/dev/null)

ifeq ($(strip $(SDL_CFLAGS)),)
  $(error SDL2 development files not found. Install libsdl2-dev and pkg-config.)
endif

DEFINES += -DLUA_USE_POSIX
fpic := -fPIC

# Conditional configuration for USE_NEXTP8_AUDIO
# Include pre-rules first (settings that must be before all: target)
ifeq ($(USE_NEXTP8_AUDIO),1)
  include Makefile.linux.nextp8_audio
endif

# SDL_LIBS typically already includes -lpthread on Linux, but keeping -lpthread is harmless.
LIBS += $(SDL_LIBS) -lpthread -lm -lssl -lcrypto
