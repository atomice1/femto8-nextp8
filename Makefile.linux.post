# Linux-specific additional targets
# png_to_p8 - a tool to convert .p8.png files to .p8 files
# parse_tree - a tool to display the parse tree of Pico-8 Lua scripts
# dialog_test - a tool for testing dialogs

PNG_TO_P8_TARGET := $(BUILD_DIR)/png_to_p8
PARSE_TREE_TARGET := $(BUILD_DIR)/parse_tree
DIALOG_TEST_TARGET := $(BUILD_DIR)/dialog_test

# png_to_p8 tool objects (parser with decompression support)
PNG_TO_P8_OBJECTS := $(BUILD_DIR)/p8_parser.o \
                     $(BUILD_DIR)/strtcpy.o \
                     $(BUILD_DIR)/lexaloffle/p8_compress.o \
                     $(BUILD_DIR)/lexaloffle/pxa_compress_snippets.o \
                     $(BUILD_DIR)/lodepng/lodepng.o \
                     $(BUILD_DIR)/png_to_p8.o

all: $(PNG_TO_P8_TARGET) $(PARSE_TREE_TARGET) $(DIALOG_TEST_TARGET)

# png_to_p8 target
$(PNG_TO_P8_TARGET): $(PNG_TO_P8_OBJECTS)
	$(CC) $(CFLAGS) $(LDFLAGS) $(PNG_TO_P8_OBJECTS) -o $@

$(BUILD_DIR)/png_to_p8.o: tools/png_to_p8.c
	$(CC) $(CFLAGS) -c $< -o $@
	$(CC) -MM $(CFLAGS) -MT $@ -MF $(BUILD_DIR)/png_to_p8.d $<

clean: clean-png-to-p8 clean-parse-tree clean-dialog-test

clean-png-to-p8:
	rm -f $(BUILD_DIR)/png_to_p8.o $(BUILD_DIR)/png_to_p8.d
	rm -f $(PNG_TO_P8_TARGET)

# parse_tree target (uses Lua parser and Pico-8 cart parser)
# Only include core Lua parser files, not p8_lua.o which has extern dependencies
PARSE_TREE_LUA_OBJECTS := $(BUILD_DIR)/lua/lapi.o \
                          $(BUILD_DIR)/lua/lauxlib.o \
                          $(BUILD_DIR)/lua/lbaselib.o \
                          $(BUILD_DIR)/lua/lcode.o \
                          $(BUILD_DIR)/lua/lcorolib.o \
                          $(BUILD_DIR)/lua/lctype.o \
                          $(BUILD_DIR)/lua/ldblib.o \
                          $(BUILD_DIR)/lua/ldo.o \
                          $(BUILD_DIR)/lua/ldump.o \
                          $(BUILD_DIR)/lua/lfunc.o \
                          $(BUILD_DIR)/lua/lgc.o \
                          $(BUILD_DIR)/lua/linit.o \
                          $(BUILD_DIR)/lua/llex.o \
                          $(BUILD_DIR)/lua/lmem.o \
                          $(BUILD_DIR)/lua/loadlib.o \
                          $(BUILD_DIR)/lua/lobject.o \
                          $(BUILD_DIR)/lua/lopcodes.o \
                          $(BUILD_DIR)/lua/lparser.o \
                          $(BUILD_DIR)/lua/lpico8lib.o \
                          $(BUILD_DIR)/lua/lstate.o \
                          $(BUILD_DIR)/lua/lstring.o \
                          $(BUILD_DIR)/lua/lstrlib.o \
                          $(BUILD_DIR)/lua/ltable.o \
                          $(BUILD_DIR)/lua/ltablib.o \
                          $(BUILD_DIR)/lua/lundump.o \
                          $(BUILD_DIR)/lua/lvm.o \
                          $(BUILD_DIR)/lua/lzio.o \
                          $(BUILD_DIR)/lua/ldebug.o \
                          $(BUILD_DIR)/lua/ltm.o

PARSE_TREE_OBJECTS := $(BUILD_DIR)/p8_parser.o \
                      $(BUILD_DIR)/strtcpy.o \
                      $(BUILD_DIR)/lexaloffle/p8_compress.o \
                      $(BUILD_DIR)/lexaloffle/pxa_compress_snippets.o \
                      $(BUILD_DIR)/lodepng/lodepng.o \
                      $(BUILD_DIR)/parse_tree.o \
                      $(PARSE_TREE_LUA_OBJECTS)

$(PARSE_TREE_TARGET): $(PARSE_TREE_OBJECTS)
	$(CC) $(CFLAGS) $(LDFLAGS) $(PARSE_TREE_OBJECTS) -o $@ $(LIBS)

$(BUILD_DIR)/parse_tree.o: tools/parse_tree.c
	$(CC) $(CFLAGS) -c $< -o $@
	$(CC) -MM $(CFLAGS) -MT $@ -MF $(BUILD_DIR)/parse_tree.d $<

clean-parse-tree:
	rm -f $(BUILD_DIR)/parse_tree.o $(BUILD_DIR)/parse_tree.d
	rm -f $(PARSE_TREE_TARGET)

# dialog_test target (interactive test with SDL)
# Build p8_dialog.o with dialog_test.o and strtcpy.o
DIALOG_TEST_OBJECTS := $(BUILD_DIR)/dialog_test.o \
                       $(filter-out $(BUILD_DIR)/main.o,$(OBJECTS))

$(DIALOG_TEST_TARGET): $(DIALOG_TEST_OBJECTS)
	$(CC) $(CFLAGS) $(LDFLAGS) $(DIALOG_TEST_OBJECTS) -o $@ $(LIBS)

$(BUILD_DIR)/dialog_test.o: tools/dialog_test.c
	$(CC) $(CFLAGS) -c $< -o $@
	$(CC) -MM $(CFLAGS) -MT $@ -MF $(BUILD_DIR)/dialog_test.d $<

clean-dialog-test:
	rm -f $(BUILD_DIR)/dialog_test.o $(BUILD_DIR)/dialog_test.d
	rm -f $(DIALOG_TEST_TARGET)

.PHONY: clean-png-to-p8 clean-parse-tree clean-dialog-test
