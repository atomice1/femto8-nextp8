pico-8 cartridge // http://www.pico-8.com
version 43
__lua__

#include test_fwk.lua

function test_fixed_point_literals()
    test_case("literal_round_trip", function()
        check_eq(tostr(0, true), "0x0000.0000", "tostr(0, true)")
        check_eq(tostr(1, true), "0x0001.0000", "tostr(1, true)")
        check_eq(tostr(-1, true), "0xffff.0000", "tostr(-1, true)")
        check_eq(tostr(2, true), "0x0002.0000", "tostr(2, true)")
        check_eq(tostr(-2, true), "0xfffe.0000", "tostr(-2, true)")

        check_eq(tostr(0x0.7fff, true), "0x0000.7fff", "tostr(0x0.7fff, true)")
        check_eq(tostr(0x0.8000, true), "0x0000.8000", "tostr(0x0.8000, true)")
        check_eq(tostr(0x0.ffff, true), "0x0000.ffff", "tostr(0x0.ffff, true)")
        check_eq(tostr(0x7fff, true), "0x7fff.0000", "tostr(0x7fff, true)")
        check_eq(tostr(0x7fff.7fff, true), "0x7fff.7fff", "tostr(0x7fff.7fff, true)")
        check_eq(tostr(0x7fff.8000, true), "0x7fff.8000", "tostr(0x7fff.8000, true)")
        check_eq(tostr(0x7fff.ffff, true), "0x7fff.ffff", "tostr(0x7fff.ffff, true)")
        check_eq(tostr(0x8000, true), "0x8000.0000", "tostr(0x8000, true)")
        check_eq(tostr(0xffff.ffff, true), "0xffff.ffff", "tostr(0xffff.ffff, true)")

        check_eq(tostr(-0x0.7fff, true), "0xffff.8001", "tostr(-0x0.7fff, true)")
        check_eq(tostr(-0x0.8000, true), "0xffff.8000", "tostr(-0x0.8000, true)")
        check_eq(tostr(-0x0.ffff, true), "0xffff.0001", "tostr(-0x0.ffff, true)")
        check_eq(tostr(-0x7fff, true), "0x8001.0000", "tostr(-0x7fff, true)")
        check_eq(tostr(-0x7fff.7fff, true), "0x8000.8001", "tostr(-0x7fff.7fff, true)")
        check_eq(tostr(-0x7fff.8000, true), "0x8000.8000", "tostr(-0x7fff.8000, true)")
        check_eq(tostr(-0x7fff.ffff, true), "0x8000.0001", "tostr(-0x7fff.ffff, true)")
        check_eq(tostr(-0x8000, true), "0x8000.0000", "tostr(-0x8000, true)")
        check_eq(tostr(-0xffff.ffff, true), "0x0000.0001", "tostr(-0xffff.ffff, true)")
    end)
end

function test_fixed_point_arithmetic()
    test_case("addition_and_subtraction", function()
        check_eq(0x0.7fff + 0x0.8000, 0x0.ffff, "0x0.7fff + 0x0.8000")
        check_eq(0x0.ffff + 1, 0x1.ffff, "0x0.ffff + 1")
        check_eq(0x7fff.7fff + 0x0.8000, 0x7fff.ffff, "0x7fff.7fff + 0x0.8000")
        check_eq(0x7fff.ffff + 0x0.0001, -0x8000.0000, "0x7fff.ffff + 0x0.0001")
        check_eq(-0x8000.0000 + 0x0.0001, -0x7fff.ffff, "-0x8000.0000 + 0x0.0001")
        check_eq(0xffff.ffff + 1, 0x0.ffff, "0xffff.ffff + 1")
        check_eq(-0xffff.ffff - 1, -0x0.ffff, "-0xffff.ffff - 1")
        check_eq(0x0.8000 - 1, -0x0.8000, "0x0.8000 - 1")
        check_eq(0x0.ffff - 0x0.ffff, 0, "0x0.ffff - 0x0.ffff")
        check_eq(0x8000.0000 - 0x0.0001, 0x7fff.ffff, "0x8000.0000 - 0x0.0001")
    end)

    test_case("multiplication_and_division", function()
        check_eq(0x0.8000 * 2, 1, "0x0.8000 * 2")
        check_eq(-0x0.8000 * 2, -1, "-0x0.8000 * 2")
        check_eq(0xffff.ffff * 0x8000, 0x0.8000, "0xffff.ffff * 0x8000")
        check_eq(-0xffff.ffff * 0x8000, -0x0.8000, "-0xffff.ffff * 0x8000")
        check_eq(1 / 2, 0x0.8000, "1 / 2")
        check_eq(-1 / 2, -0x0.8000, "-1 / 2")
        check_eq(0x0.8000 / 0x0.8000, 1, "0x0.8000 / 0x0.8000")
        check_eq(0x0.ffff / 0x0.ffff, 1, "0x0.ffff / 0x0.ffff")
        check_eq(0x7fff.8000 / 0x8000, -0x0.ffff, "0x7fff.8000 / 0x8000")
        check_eq(-0x7fff.8000 / 0x8000, 0x0.ffff, "-0x7fff.8000 / 0x8000")
        check_eq(0x7fff \ 0x7fff, 1, "0x7fff \\ 0x7fff")
        check_eq(0xffff.ffff \ 1, -1, "0xffff.ffff \\ 1")
        check_eq(0x7fff.ffff % 1, 0x0.ffff, "0x7fff.ffff % 1")
        check_eq(0xffff.ffff % 1, 0x0.ffff, "0xffff.ffff % 1")
    end)
end

function test_fixed_point_math()
    test_case("min_max_mid", function()
        check_eq(max(0x7fff, 0x7fff.ffff), 0x7fff.ffff, "max(0x7fff, 0x7fff.ffff)")
        check_eq(min(-0x7fff.8000, -0x7fff), -0x7fff.8000, "min(-0x7fff.8000, -0x7fff)")
        check_eq(mid(-2, 0x0.8000, 2), 0x0.8000, "mid(-2, 0x0.8000, 2)")
        check_eq(mid(-0x7fff, 0x0.ffff, 0x7fff), 0x0.ffff, "mid(-0x7fff, 0x0.ffff, 0x7fff)")
    end)

    test_case("floor_and_ceil", function()
        check_eq(flr(0x0.ffff), 0, "flr(0x0.ffff)")
        check_eq(flr(-0x0.7fff), -1, "flr(-0x0.7fff)")
        check_eq(flr(-0x0.8000), -1, "flr(-0x0.8000)")
        check_eq(ceil(0x0.7fff), 1, "ceil(0x0.7fff)")
        check_eq(ceil(0x0.8000), 1, "ceil(0x0.8000)")
        check_eq(ceil(-0x0.7fff), 0, "ceil(-0x0.7fff)")
        check_eq(ceil(-0x0.8000), 0, "ceil(-0x0.8000)")
    end)

    test_case("trigonometry", function()
        check_eq(cos(0), 1, "cos(0)")
        check_eq(cos(0x0.8000), -1, "cos(0x0.8000)")
        check_eq(sin(0), 0, "sin(0)")
        check_eq(sin(0x0.8000), 0, "sin(0x0.8000)")
        check_eq(atan2(1, 0), 0, "atan2(1, 0)")
        check_eq(atan2(0, -1), 0.25, "atan2(0, -1)")
        check_eq(atan2(-1, 0), 0.5, "atan2(-1, 0)")
        check_eq(atan2(0, 1), 0.75, "atan2(0, 1)")
    end)

    test_case("sqrt_and_abs", function()
        check_eq(sqrt(0), 0, "sqrt(0)")
        check_eq(sqrt(1), 1, "sqrt(1)")
        check_eq(sqrt(0x0.8000 * 0x0.8000), 0x0.8000, "sqrt(0x0.8000 * 0x0.8000)")
        check_eq(abs(-0x7fff.8000), 0x7fff.8000, "abs(-0x7fff.8000)")
        check_eq(abs(-0xffff.ffff), 0x0.0001, "abs(-0xffff.ffff)")
    end)

    test_case("sgn", function()
        check_eq(sgn(-0x0.0001), -1, "sgn(-0x0.0001)")
        check_eq(sgn(0), 1, "sgn(0)")
        check_eq(sgn(0x0.0001), 1, "sgn(0x0.0001)")
    end)

    test_case("bitwise_and_shifts", function()
        check_eq(band(0b1010, 0b0110), 0B0010, "band(0b1010, 0b0110)")
        check_eq(bor(0b1001, 0b1010), 0b1011, "bor(0b1001, 0b1010)")
        check_eq(bxor(0b101, 0b110), 0b011, "bxor(0b101, 0b110)")
        check_eq(bnot(0b110), 0b1111111111111001.1111111111111111, "bnot(0b110)")
        check_eq(shl(0b101, 3), 0b101000, "shl(0b101, 3)")
        check_eq(shr(0b1111111111101000, 3), 0b1111111111111101, "shr(0b1111111111101000, 3)")
        check_eq(lshr(0b101000, 3), 0b000101, "lshr(0b101000, 3)")
        check_eq(rotl(0b10100, 2), 0b1010000, "rotl(0b10100, 2)")
        check_eq(rotr(0b10100, 2), 0b00101, "rotr(0b10100, 2)")
    end)

    test_case("string_and_number_conversion", function()
        check_eq(tostr(17), "17", "tostr(17)")
        check_eq(tostr(17, 0x1), "0x0011.0000", "tostr(17, 0x1)")
        check_eq(tostr(17, 0x2), "1114112", "tostr(17, 0x2)")
        check_eq(tostr(17, 0x3), "0x00110000", "tostr(17, 0x3)")
        check_eq(tonum("ff", 0x1), 255)
        check_eq(tonum("1114112", 0x2), 17)
        check_eq(tonum("1234abcd", 0x3), 0x1234.abcd)
        check_eq(tonum(true), 1, "tonum(true)")
        check_eq(tonum(false), 0, "tonum(false)")
        check_eq(chr(64), "@", "chr(64)")
        check_eq(chr(104,101,108,108,111), "hello", "chr(104,101,108,108,111)")
        check_eq(ord("@"), 64)
        check_eq(ord("123", 2), 50)
        check_eq({ord("123", 2, 3)}, {50, 51})
        check_eq(split(123), {123}, "split(123)")
        check_eq(split("1,2,3"), {1, 2, 3})
        check_eq(split("one:two:3", ":", false), {"one", "two", "3"})
        check_eq(split("1,,2,"), {1, "", 2, ""})
    end)

    test_case("rnd_and_srand", function()
        srand(0xffff.ffff)
        local first_sample = rnd(0x7fff.ffff)
        local second_sample = rnd(0x7fff.ffff)

        check_ge(first_sample, 0)
        check_lt(first_sample, 0x7fff.ffff)
        check_ge(second_sample, 0)
        check_lt(second_sample, 0x7fff.ffff)

        srand(0xffff.ffff)
        check_eq(first_sample, rnd(0x7fff.ffff), "first_sample")
        check_eq(second_sample, rnd(0x7fff.ffff), "second_sample")
    end)
end

function test_fixed_point_tostr()
    test_case("small_positive_integers", function()
        check_eq(tostr(0x0000.0001), "0", "tostr(0x0000.0001)")
        check_eq(tostr(0x0000.0006), "0", "tostr(0x0000.0006)")
        check_eq(tostr(0x0000.0007), "0.0001", "tostr(0x0000.0007)")
        check_eq(tostr(0x0000.000a), "0.0002", "tostr(0x0000.000a)")
        check_eq(tostr(0x0000.000b), "0.0002", "tostr(0x0000.000b)")
        check_eq(tostr(0x0000.0010), "0.0002", "tostr(0x0000.0010)")
        check_eq(tostr(0x0000.0011), "0.0003", "tostr(0x0000.0011)")
    end)
    test_case("small_negative_positive_integers", function()
        check_eq(tostr(0xffff.ffff), "-0", "tostr(0xffff.ffff)")
        check_eq(tostr(0xffff.fffa), "-0", "tostr(0xffff.fffa)")
        check_eq(tostr(0xffff.fff9), "-0.0001", "tostr(0xffff.fff9)")
    end)
    test_case("positive_rounding", function()
        check_eq(tostr(0x002c.cccc), "44.8", "tostr(0x002c.cccc)")
        check_eq(tostr(0x002c.ccca), "44.8", "tostr(0x002c.ccca)")
        check_eq(tostr(0x002c.ccc9), "44.7999", "tostr(0x002c.ccc9)")
        check_eq(tostr(0x002c.ccc0), "44.7998", "tostr(0x002c.ccc0)")
        check_eq(tostr(0x002c.cc00), "44.7969", "tostr(0x002c.cc00)")
        check_eq(tostr(0x002c.c000), "44.75", "tostr(0x002c.c000)")
        check_eq(tostr(0x002c.0000), "44", "tostr(0x002c.0000)")
        check_eq(tostr(0x002c.cccf), "44.8", "tostr(0x002c.cccf)")
        check_eq(tostr(0x002c.ccd0), "44.8", "tostr(0x002c.ccd0)")
        check_eq(tostr(0x002c.ccd1), "44.8001", "tostr(0x002c.ccd1)")
        check_eq(tostr(0x002c.ccff), "44.8008", "tostr(0x002c.ccff)")
        check_eq(tostr(0x002c.cfff), "44.8125", "tostr(0x002c.cfff)")
        check_eq(tostr(0x002c.ffff), "45", "tostr(0x002c.ffff)")

        check_eq(tostr(0x002d.cccc), "45.8", "tostr(0x002d.cccc)")
        check_eq(tostr(0x002d.ccca), "45.8", "tostr(0x002d.ccca)")
        check_eq(tostr(0x002d.ccc9), "45.7999", "tostr(0x002d.ccc9)")
        check_eq(tostr(0x002d.ccc0), "45.7998", "tostr(0x002d.ccc0)")
        check_eq(tostr(0x002d.cc00), "45.7969", "tostr(0x002d.cc00)")
        check_eq(tostr(0x002d.c000), "45.75", "tostr(0x002d.c000)")
        check_eq(tostr(0x002d.0000), "45", "tostr(0x002d.0000)")
        check_eq(tostr(0x002d.cccf), "45.8", "tostr(0x002d.cccf)")
        check_eq(tostr(0x002d.ccd0), "45.8", "tostr(0x002d.ccd0)")
        check_eq(tostr(0x002d.ccd1), "45.8001", "tostr(0x002d.ccd1)")
        check_eq(tostr(0x002d.ccff), "45.8008", "tostr(0x002d.ccff)")
        check_eq(tostr(0x002d.cfff), "45.8125", "tostr(0x002d.cfff)")
        check_eq(tostr(0x002d.ffff), "46", "tostr(0x002d.ffff)")
    end)
    test_case("negative_rounding", function()
        check_eq(tostr(0xffd3.3333), "-44.8", "tostr(0xffd3.3333)")
        check_eq(tostr(0xffd3.3335), "-44.8", "tostr(0xffd3.3335)")
        check_eq(tostr(0xffd3.3337), "-44.7999", "tostr(0xffd3.3337)")
        check_eq(tostr(0xffd3.3330), "-44.8", "tostr(0xffd3.3330)")
        check_eq(tostr(0xffd3.332f), "-44.8001", "tostr(0xffd3.332f)")

        check_eq(tostr(0xffd2.3333), "-45.8", "tostr(0xffd2.3333)")
        check_eq(tostr(0xffd2.3335), "-45.8", "tostr(0xffd2.3335)")
        check_eq(tostr(0xffd2.3337), "-45.7999", "tostr(0xffd2.3337)")
        check_eq(tostr(0xffd2.3330), "-45.8", "tostr(0xffd2.3330)")
        check_eq(tostr(0xffd2.332f), "-45.8001", "tostr(0xffd2.332f)")
    end)
end

function _init()
    test_suite("fixed_point_arithmetic", function()
        test_fixed_point_literals()
        test_fixed_point_arithmetic()
        test_fixed_point_math()
        test_fixed_point_tostr()
    end)
    summary()
end
